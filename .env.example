# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# --- Required ---------------------------------------------------------------
# Neon Postgres connection string (pooled).
DATABASE_URL=postgres://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Web Push (optional: notifications are off when unset) -------------------
# Generate a key pair with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# --- Rest-timer push via Upstash QStash (optional) ----------------------------
# Needed for "rest complete" notifications while the app is in the background.
# Without these, the in-app timer still beeps/vibrates and the app shows a
# local notification when it can. Get them at console.upstash.com → QStash.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for the EU region or a local QStash dev server, e.g. https://qstash-eu-central-1.upstash.io
QSTASH_URL=

# Public URL QStash calls back. Defaults to the Vercel production domain, then
# to the request's origin. Set it if you use a custom domain.
APP_URL=https://repiq.example.com
